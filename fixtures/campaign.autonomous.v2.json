{
  "contractVersion": "creator.campaign.sim.v2",
  "campaignId": "round2-demo",
  "topic": "deterministic autonomous creator simulation",
  "cycles": 3,
  "maxAttemptsPerStage": 3,
  "maxCriticRevisions": 2,
  "critic": {
    "revisionStage": "script",
    "rejectsByCycle": {"1": 1, "2": 0, "3": 1}
  },
  "failures": {
    "1": {"research": [1], "script": [1], "assets": [1]},
    "2": {"voice": [1], "media": [1], "critic": [1]},
    "3": {"queue": [1], "analytics": [1]}
  },
  "media": {
    "timeline": {
      "id": "round2-canonical-timeline",
      "version": 1,
      "canvas": {"width": 720, "height": 1280, "fps": 30, "durationMs": 4000},
      "tracks": [
        {"id": "captions", "kind": "caption", "items": [{"id": "caption-1", "startMs": 500, "endMs": 1700, "text": "Round 2 deterministic plan", "style": {"fontSize": 40}}]},
        {"id": "video", "kind": "video", "items": [
          {"id": "clip-1", "startMs": 0, "endMs": 2000, "source": {"uri": "round2-input/clip-a.mp4", "inMs": 0}},
          {"id": "clip-2", "startMs": 2000, "endMs": 4000, "source": {"uri": "round2-input/clip-b.mp4", "inMs": 250}}
        ]}
      ]
    },
    "exportSpec": {
      "videoCodec": "libx264",
      "audioCodec": "aac",
      "videoBitrate": "4M",
      "audioBitrate": "128k",
      "pixelFormat": "yuv420p"
    },
    "outputPathTemplate": "round2-temp/{campaign_id}/{cycle}.mp4"
  }
}
